# Copy this file to secrets.toml. secrets.toml is git-ignored.
# Never push a real key to GitHub.
#
# Pick ONE provider by uncommenting its block.

# --- Option 1: Gemini (default) ---
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-key-here"
# LLM_MODEL = "gemini-3.8-flash"

# --- Option 2: Groq (free hosted API, fast, can be deployed online) ---
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "your-groq-key-here"
# LLM_MODEL = "llama-3.3-70b-versatile"

# --- Option 3: Ollama (runs on your own computer, no key, no quota) ---
# LLM_PROVIDER = "ollama"
# LLM_MODEL = "llama3.2"
